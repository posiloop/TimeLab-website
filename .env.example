# 複製為 .env 後填入實際值。.gitignore 已涵蓋 .env*，此範本不含任何密鑰。

# PostgreSQL 連線字串
DATABASE_URL="postgresql://user@localhost:5432/timelab_website"

# Better Auth。密鑰用 `openssl rand -base64 32` 產生，至少 32 字元
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# AWS S3。IAM 只需 PutObject / DeleteObject，不要給 ListBucket 或 DeleteBucket
AWS_REGION="ap-east-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""

# 媒體檔案的公開網址前綴。兩種擇一，不含結尾斜線：
#   直連 S3     https://<bucket>.s3.<region>.amazonaws.com
#   CloudFront  https://media.timelabtw.com
#
# 資料庫只存 S3 key，完整網址在 app/server/s3.ts 的 mediaUrl() 組成，
# 所以日後要從 S3 換成 CloudFront，改這一個值即可，不必動任何資料。
#
# 此值會出現在傳給瀏覽器的 props，故需 NEXT_PUBLIC_ 前綴；
# bucket 名稱與金鑰則絕不可加前綴，那會被打包進前端 bundle
NEXT_PUBLIC_MEDIA_URL=""

# 建立第一個後台帳號用（scripts/seed-admin.ts），建立完可移除
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="管理員"
