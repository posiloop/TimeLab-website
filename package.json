{
  "name": "timelab-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "bun --env-file=.env node_modules/prisma/build/index.js generate",
    "db:migrate": "bun --env-file=.env node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "bun --env-file=.env node_modules/prisma/build/index.js migrate deploy",
    "db:studio": "bun --env-file=.env node_modules/prisma/build/index.js studio",
    "seed:admin": "bun --env-file=.env scripts/seed-admin.ts",
    "seed:content": "bun --env-file=.env prisma/seed/migrate-content.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7",
    "better-auth": "^1.7.5",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^7",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.6",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@prisma/engines",
    "prisma",
    "sharp",
    "unrs-resolver"
  ]
}
